NODE_ENV=test
TRACE=0
DB_DEBUG=0
PROVIDER_NETWORK_RPC_URLS=http://btc:password@127.0.0.1:18332
MAX_BLOCK_HEIGHT=2
START_BLOCK_HEIGHT=0
BLOCKS_QUEUE_LOADER_REQUEST_BLOCKS_BATCH_SIZE=10
NETWORK_TYPE=testnet
NETWORK_PROVIDER_TYPE=rpc
NETWORK_MAX_BLOCK_WEIGHT=1
BLOCKS_QUEUE_ITERATOR_BLOCKS_BATCH_SIZE=2
NETWORK_TARGET_BLOCK_TIME=1000
LOG_LEVEL=error
# Set to 0 for tests so every snapshot immediately triggers rotation
NETWORK_IRREVERSIBLE_DEPTH=0
# Set to true to test pruning (archived files deletion)
ALLOW_PRUNING=false
